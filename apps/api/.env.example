PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
LOG_LEVEL=info

# Postgres via Docker Compose (host 15432 — avoids local Postgres on 5432/5433)
DATABASE_URL=postgresql://cerotres:cerotres@127.0.0.1:15432/cerotres?schema=public

# Seed (change these — never commit real secrets)
OWNER_EMAIL=owner@cerotres.com
OWNER_PASSWORD=ChangeMeNow123!
OWNER_NAME=Owner Cero Tres

PEDIDOS_YA_PERCENT=0.2500
PEDIDOS_YA_EFFECTIVE_FROM=2024-01-01
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars!!
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars!
WEB_APP_URL=http://localhost:5173

# Pedido por texto (solo servidor — nunca en frontend ni en git con valor real)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6